# Copy this file to .env (local scripts) and also set these same two values in
# Vercel: Project Settings -> Environment Variables (for the API routes).
#
# Get both from: Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ^ Service role key, NOT the anon/public key. The service role key bypasses Row Level
# Security so the API layer can enforce the access-code permission logic instead --
# same trust model as hope-pmo-v2. Never expose this key to the browser/frontend; it
# only ever lives in Vercel's server-side environment and in your own local .env,
# never in client-side code. (The database password is not used by the app at all --
# the app talks to Supabase through this key.)

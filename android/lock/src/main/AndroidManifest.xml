<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Turning the radio back on when a handset has gone dark. setWifiEnabled has been
         refused for ordinary apps since Android 10 and a Device Owner is exempt, but the
         permission is still required, and without it the call fails on a phone nobody can
         reach to find out. See Net.java for why this matters more than it looks: a locked
         phone is pinned in lock task, so whoever is holding it cannot rejoin a network
         themselves, not even to free a handset they have already paid off. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Where the handset was when it last synced, so unaccounted stock is a place to go
         rather than a name on a list. These are RUNTIME permissions and there is nobody at a
         locked phone to tap Allow, so LockAdmin.harden grants them to itself as Device Owner
         and unharden hands them back on release. The app never asks for a live fix: it reads
         whatever position the system already has. See Loc.java. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Held so the app can install its own updates. As Device Owner Android performs that
         install without prompting anybody, which is the point: there is nobody at a locked
         handset who should be tapping "install". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Lock">

        <!-- NO LAUNCHER ICON, deliberately. There is nothing here for a person to open: the
             app either shows the lock screen or stays out of the way entirely. An icon would
             only be an invitation to poke at it. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- The Device Owner receiver. PROFILE_PROVISIONING_COMPLETE is where a QR-provisioned
             phone first hands us the server URL and its token. -->
        <receiver
            android:name=".LockAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- A locked phone that is rebooted must come back locked, so the beat is rescheduled
             and the lock screen restored the moment the system is up. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The adb enrolment route. Exported because adb has to be able to reach it; the
             receiver itself refuses everything except a first token on a phone that is
             already Device Owner. See EnrolReceiver for why that guard is enough. -->
        <receiver
            android:name=".EnrolReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.samaritantechs.hooploanlock.ENROL" />
            </intent-filter>
        </receiver>

        <!-- The adb release route: the way back out when the server cannot reach a handset.
             Exported so adb can reach it; guarded by this handset's own token, which only the
             office holds. See ReleaseReceiver for why that guard is enough and why it does not
             weaken the lock on a phone in the field. -->
        <receiver
            android:name=".ReleaseReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.samaritantechs.hooploanlock.RELEASE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".BeatJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- THE DOORBELL. Firebase delivers here and the app beats immediately, which is how
             an order given in the office reaches a handset in about a second rather than
             at its next turn. What arrives carries NO command: see Push.java, where acting on
             the payload would be the bug rather than the feature.

             Declared unconditionally. On a build without google-services.json the class is
             not compiled in and nothing can ever deliver to it, so the entry is inert, and it
             stays inert rather than becoming a way in, because it is not exported. -->
        <service
            android:name=".Push"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- No notification icon or channel is declared, on purpose. These are DATA-ONLY
             messages, handed straight to the app and never drawn on the customer's screen.
             There is nothing here for them to read, and on a locked handset the notification
             shade is not reachable anyway. -->

    </application>
</manifest>

{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/call", "destination": "/call.html" },
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/portal", "destination": "/portal.html" },
    { "source": "/dashboard", "destination": "/portal.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(call|upload|portal|dashboard)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/brand.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
